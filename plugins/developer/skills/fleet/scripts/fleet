#!/usr/bin/env bash
# The fleet's one command: it runs the script behind each user-facing command, so `/fleet <command>` and a shell
# call the same code.
#
#   fleet <command> [args...]     run the command with its arguments; its reply is the command's own output
#   fleet help                    the table | Command | What it does | Example |, one row per command
#   fleet help <command>          that command's usage: its script's # header, unchanged
#
# A command is a script in this directory whose header has the line `# Command: <what it does> · e.g. fleet <example>`.
# help reads those lines, so the list is what the scripts say and cannot drift from them. There are eleven: status, run,
# boot, tell, retire, park, candidates, decide, hold, claim and help. A script whose line says `# Internal command:` runs
# the same way for the loop and the agents but is never listed; a script with neither line (common.sh, registry.sh,
# tick.sh, linear.sh, ...) is not a command at all. Two commands have no script of their own: claim (linear.sh: claim,
# `--who` for holder, `--take` for takeover) and the internal escalate (registry.sh); claim turns the JSON into its line.
# A 4.x command that 5.0 renamed or removed answers with the one to use now and exits 2.
# A command that fails ends with the error form, "<command>: <what failed>. <the one next step>." (references/
# output.md), made from its last line on stderr, with "Run fleet help <command>." when that line names no next step;
# its other stderr lines come first, unchanged, and the exit status is the command's. An unknown command exits 2 and
# prints the list on stderr. Agents keep calling the .sh scripts by absolute path (their allow lists name them);
# this is for the user and the Orchestrator.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac; done
D="$(cd "$(dirname "$src")" && pwd)"
. "$D/common.sh"

aliases() { # <name> <script> <subcommand> <what it does · e.g. example>, for the commands with no script of their own
  printf '%s\t%s\t%s\t%s\n' \
    claim linear claim 'Claim an issue on Linear for this machine; --who says who holds it, --take takes a lapsed claim · e.g. fleet claim DEV-123 --who'
}
internal_aliases() { # the same, for the internal commands
  printf '%s\t%s\t%s\t%s\n' \
    escalate registry escalate 'Raise a question by severity; it stays open until decided · e.g. fleet escalate build-api/lead P1 "which database?" postgres sqlite'
}

# renamed <4.x command>: what to run in 5.0, or nothing for a command that still exists.
renamed() {
  case "$1" in
    unpark) echo "fleet park <team> --undo" ;;
    unhold) echo "fleet hold <PR> --off" ;;
    holder) echo "fleet claim <ISSUE> --who" ;;
    takeover) echo "fleet claim <ISSUE> --take" ;;
    escalations) echo "fleet decide (no arguments lists the open questions)" ;;
    resolve) echo "fleet decide <team> <id> --answer \"<answer>\"" ;;
    watch) echo "fleet run watch" ;;
    schedule) echo "fleet run schedule <install|status|uninstall>" ;;
    prime) echo "fleet status" ;;
    config) echo "fleet run show" ;;
    branches) echo "nothing: retire and the loop delete branches" ;;
    debrief) echo "nothing: lessons are written when a team retires" ;;
    focus) echo "fleet park <team> for each team to set aside" ;;
    metrics) echo "nothing: the morning report says what happened" ;;
    slim) echo "nothing: the panel style is gone" ;;
  esac
}

internal_commands() { # the internal commands, the same four fields
  local f n line
  for f in "$D"/*.sh; do
    line="$(awk 'NR == 1 { next } !/^#/ { exit } sub(/^# Internal command: /, "") { print; exit }' "$f")"
    n="$(basename "$f" .sh)"
    [ -z "$line" ] || printf '%s\t%s\t-\t%s\n' "$n" "$n" "$line"
  done
  internal_aliases
}

commands() { # one line per command, by name: <name> TAB <script> TAB <subcommand or -> TAB <what it does · e.g. example>; `commands all` adds the internal ones
  local f n line
  {
    for f in "$D"/*.sh; do
      line="$(awk 'NR == 1 { next } !/^#/ { exit } sub(/^# Command: /, "") { print; exit }' "$f")"
      n="$(basename "$f" .sh)"
      [ -z "$line" ] || printf '%s\t%s\t-\t%s\n' "$n" "$n" "$line"
    done
    aliases
    [ "${1:-}" != all ] || internal_commands
    printf '%s\t-\t-\t%s\n' help "List the commands, or show one command's usage · e.g. fleet help status"
  } | LC_ALL=C sort -t "$(printf '\t')" -k1,1
}

list() {
  local n s sub line what ex
  printf '| Command | What it does | Example |\n|---|---|---|\n'
  while IFS=$'\t' read -r n s sub line; do
    what="${line%% · e.g. *}"; ex=""; [ "$what" = "$line" ] || ex="${line#* · e.g. }"
    printf '| `%s` | %s | `%s` |\n' "$n" "$what" "$ex"
  done < <(commands)
}

header() { awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$1"; } # a script's # header, comment marks off

usage() { # usage <command>: 1 when there is no such command
  local row n s sub line
  row="$(commands all | awk -F'\t' -v c="$1" '$1 == c')"
  [ -n "$row" ] || return 1
  IFS=$'\t' read -r n s sub line <<<"$row"
  if [ "$n" = help ]; then header "$D/fleet"
  elif [ "$sub" = - ]; then header "$D/$s.sh"
  else
    header "$D/$s.sh" | awk -v p="  $s.sh $sub" '
      index($0, p) == 1 && (length($0) == length(p) || substr($0, length(p) + 1, 1) == " ") { on = 1; print; next }
      on && /^          / { print; next }
      { on = 0 }'
    printf 'Command: %s\n' "$line"
  fi
}

# present <command> <JSON file>: the reply line or table for a command whose script prints JSON.
present() {
  local j h who
  j="$(cat "$2")"
  who="$(cfg_str machine_name '')"; [ -n "$who" ] || who="$(machine_label)"
  case "$1" in
    claim) if [ "$(jq -r '.claimed // false' <<<"$j")" = true ]; then render_line claimed issue="$(jq -r .issue <<<"$j")" machine="$who"; else printf '%s\n' "$j"; fi ;;
    takeover) render_line took_over issue="$(jq -r .issue <<<"$j")" machine="$(jq -r .from <<<"$j")" ;;
    holder) h="$(jq -r '.heartbeat // ""' <<<"$j")" # no heartbeat age is printed: only "lapsed" or "no heartbeat"
      render_line holder issue="$(jq -r .issue <<<"$j")" \
        machine="$(jq -r --arg w "$who" 'if .holder == null then "" elif .ours then "this machine (\($w))" else .holder end' <<<"$j")" \
        nohb="$([ -n "$h" ] || echo yes)" \
        lapsed="$([ "$(jq -r '.lapsed' <<<"$j")" != true ] || echo yes)" ;;
    *) printf '%s\n' "$j" ;;
  esac
}

# relay <command> <stderr file> <exit status>: a failed command's stderr, its last line in the error form.
relay() {
  local last msg
  [ -s "$2" ] || { render_error "$1" "it exited $3" >&2; return; }
  sed '$d' "$2" >&2
  last="$(tail -n 1 "$2")"
  case "$last" in "$1: "*) printf '%s\n' "$last" >&2; return ;; esac
  msg="${last#fleet: }"; msg="${msg#warning: }"
  case "$msg" in
    *.) printf '%s: %s\n' "$1" "$msg" >&2 ;; # it already ends with its next step
    *) render_error "$1" "$msg" >&2 ;;
  esac
}

unknown() {
  local r; r="$(renamed "$1")"
  case "$r" in
    "") ;;
    nothing:*) printf "fleet: '%s' is gone in 5.0: %s.\n" "$1" "${r#nothing: }" >&2; exit 2 ;;
    *) printf "fleet: '%s' is gone in 5.0. Run %s.\n" "$1" "$r" >&2; exit 2 ;;
  esac
  printf "fleet: unknown command '%s'. Run fleet help.\n\n" "$1" >&2; list >&2; exit 2
}

cmd="${1:-}"; [ $# = 0 ] || shift
case "$cmd" in
  "") list >&2; exit 2 ;;
  help)
    if [ $# = 0 ]; then list; exit 0; fi
    usage "$1" || unknown "$1"
    exit 0 ;;
esac
[ -z "$(renamed "$cmd")" ] || unknown "$cmd" # a 4.x name points to its 5.0 command, even when its script lives on as internal
row="$(commands all | awk -F'\t' -v c="$cmd" '$1 == c')"
[ -n "$row" ] || unknown "$cmd"
IFS=$'\t' read -r n s sub line <<<"$row"
run=("$D/$s.sh"); [ "$sub" = - ] || run+=("$sub")
# claim --who and claim --take are linear.sh holder and takeover, with their own reply lines.
present_as=$cmd
if [ "$cmd" = claim ]; then
  args=(); for a in "$@"; do case "$a" in --who) run=("$D/linear.sh" holder); present_as=holder ;; --take) run=("$D/linear.sh" takeover); present_as=takeover ;; *) args+=("$a") ;; esac; done
  set -- ${args[@]+"${args[@]}"}
fi
# The sandbox can be an interactive shell, whose prompt is on stderr: it runs as it is and prints its own line.
[ "$cmd" != sandbox ] || exec "${run[@]}" "$@"
errf="$(mktemp "${TMPDIR:-/tmp}/fleet-err.XXXXXX")"; outf=""
trap 'rm -f "$errf" ${outf:+"$outf"}' EXIT
rc=0
case "$cmd" in
  claim)
    outf="$(mktemp "${TMPDIR:-/tmp}/fleet-out.XXXXXX")"
    "${run[@]}" "$@" >"$outf" 2>"$errf" || rc=$?
    if [ "$rc" = 0 ]; then present "$present_as" "$outf"; [ ! -s "$errf" ] || cat "$errf" >&2; fi ;;
  *) "${run[@]}" "$@" 2>"$errf" || rc=$?
     [ "$rc" != 0 ] || [ ! -s "$errf" ] || cat "$errf" >&2 ;;
esac
[ "$rc" = 0 ] || relay "$cmd" "$errf" "$rc"
exit "$rc"
